# DRAFT reference only: do not install/start without owner-approved D2 hosting.
[Unit]
Description=Church Times public Node host (draft reference)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=churchtimes-public
Group=churchtimes-public
WorkingDirectory=/opt/churchtimes-public/current
EnvironmentFile=/etc/churchtimes/public-host.env
ExecStart=/usr/bin/node tools/public-host.mjs
# systemctl reload reloads the private redirect map only; a new release or env change needs systemctl restart.
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictNamespaces=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryMax=512M
TasksMax=128
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/churchtimes-public /etc/churchtimes
UMask=0077

[Install]
WantedBy=multi-user.target
