# DRAFT PUBLIC runtime values; synthetic origins only. Never commit a real private map.
HOST=127.0.0.1
PORT=5373
PUBLIC_DIST=/opt/churchtimes-public/current/dist
PUBLIC_SITE_URL=https://public-staging.example.test
PUBLIC_CMS_URL=https://cms-staging.example.test
PUBLIC_BASE_PATH=/
PUBLIC_INDEXABLE=false
# Owner decision D1. Must equal the CMS PUBLIC_ARTICLE_PATH_TEMPLATE. Use /reports/{slug}/ only as a rollback.
PUBLIC_ARTICLE_PATH_TEMPLATE=/{slug}/
# Old hosts that 301 to PUBLIC_SITE_URL with the same path (default shown; www. forms are added automatically):
# LEGACY_SITE_HOSTS=churchtimesnigeria.org,churchtimesnigeria.com
PUBLIC_HOST_SHUTDOWN_MS=10000
# Add only after the private file is provisioned and validated:
# PUBLIC_REDIRECTS_FILE=/etc/churchtimes/private/redirects.json
# REDIRECT_ALLOWED_HOSTS=public-staging.example.test
# PUBLIC_REDIRECT_ALLOWED_HOSTS=public-staging.example.test
# Optional instead of the local file, after real CMS integration approval:
# PUBLIC_REDIRECTS_URL=https://cms-staging.example.test/api/public/redirects
# Leave ads.txt, verification, campaigns and external-script settings unset.
# Share cards (Open Graph PNG from the CMS, apps/cms/docs/w12/growth.md). Must match the CMS SHARE_CARDS_ENABLED=true,
# otherwise the tags point at a 404. fallback = only for articles without a featured image; always = every article.
# PUBLIC_SHARE_CARDS=fallback
