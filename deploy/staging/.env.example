# Non-secret settings for the staging stack. setup.sh writes the real deploy/staging/.env (gitignored); docker compose reads
# it automatically for ${...} interpolation, and build-static.sh / update.sh read it too. Nothing secret belongs here:
# the Turnstile SITE key is public (it is compiled into the website).

# Base hostname. The three hostnames are derived from it:
#   <STAGING_DOMAIN>, newsroom.<STAGING_DOMAIN>, cms.<STAGING_DOMAIN>
# All must stay under one registrable domain (churchtimesnigeria.net): the CMS cookie is same-site, host-only.
STAGING_DOMAIN=staging.churchtimesnigeria.net

# Cloudflare Turnstile SITE key (public) and the widget action. The action must equal TURNSTILE_EXPECTED_ACTION in .env.cms.
TURNSTILE_SITE_KEY=
TURNSTILE_ACTION=submit-story

# CMS image: built by GitHub Actions, pulled from GHCR (private). Tag "staging" moves; a full git SHA pins a build.
CMS_IMAGE=ghcr.io/abcentech/churchtimes-cms:staging

# Git ref deployed by update.sh by default.
REPO_REF=feat/newsroom-mvp

# ACME directory. Let's Encrypt production by default. For a dry run use https://acme-staging-v02.api.letsencrypt.org/directory
# (browsers will not trust those certificates; switch back and restart Caddy afterwards).
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Root-only file with the generated SYNTHETIC staff passwords (mounted read-only into the one-shot seed container).
SEED_CREDENTIALS_FILE=/root/churchtimes-staging-credentials.json
