# Church Times CMS: STAGING environment template. NO real values here.
# setup.sh generates the real file (deploy/staging/.env.cms, mode 600, root-only, gitignored) and keeps existing secrets on
# re-runs. Every name below is read by apps/cms (src/payload.config.ts, src/lib/*). A wrong or misspelt name is silently
# ignored by the app, so do not rename anything.
#
# <STAGING_DOMAIN> below stands for the base hostname, default staging.churchtimesnigeria.net.

# --- Database ----------------------------------------------------------------------------------------------------------
# Generated by setup.sh. Host "postgres" is the compose service; the password equals POSTGRES_PASSWORD in .env.postgres.
DATABASE_URL=postgres://churchtimes:<generated-postgres-password>@postgres:5432/churchtimes

# --- Server secrets (setup.sh: openssl rand -hex) ----------------------------------------------------------------------
# >= 32 chars. Signs login tokens; changing it signs every user out.
PAYLOAD_SECRET=<generated-64-hex>
# >= 32 chars and DIFFERENT from PAYLOAD_SECRET. HMAC for article preview tokens.
PREVIEW_SECRET=<generated-64-hex>
# >= 16 chars. Salt for hashing client IPs on submissions.
IP_HASH_SALT=<generated-32-hex>

# --- Cloudflare Turnstile ------------------------------------------------------------------------------------------------
# The widget's SECRET key. Prompted by setup.sh with hidden input. Never commit, never paste into chat or GitHub.
# Production mode rejects Cloudflare's dummy test secrets.
TURNSTILE_SECRET_KEY=<prompted-by-setup.sh>
# Hostnames the widget runs on: the PUBLIC site hostname. Must also be in the widget's hostname list in Cloudflare.
TURNSTILE_ALLOWED_HOSTNAMES=<STAGING_DOMAIN>
# Must equal VITE_TURNSTILE_ACTION of the public build (build-static.sh passes TURNSTILE_ACTION from .env).
TURNSTILE_EXPECTED_ACTION=submit-story

# --- Origins (https only in production; bare origins, no trailing slash, no wildcards) -------------------------------------
# This CMS's own public origin (also used for media and password-reset URLs, and added to the CSRF list automatically).
CMS_PUBLIC_URL=https://cms.<STAGING_DOMAIN>
# Browser frontends allowed to call the API: the public site and the newsroom.
CMS_CORS_ORIGINS=https://<STAGING_DOMAIN>,https://newsroom.<STAGING_DOMAIN>
# Origins allowed to make cookie-authenticated requests (payload-token cookie): the newsroom and the CMS admin itself.
CMS_CSRF_ORIGINS=https://newsroom.<STAGING_DOMAIN>,https://cms.<STAGING_DOMAIN>
# Origins allowed to POST /api/public/submissions (tip form): the public site only.
PUBLIC_SUBMISSION_ORIGINS=https://<STAGING_DOMAIN>

# --- Reverse proxy / client IP (rate limits) ---------------------------------------------------------------------------
# REQUIRED to be exactly "true" in production. Caddy overwrites X-Forwarded-For with the TCP peer address on every request.
TRUST_PROXY=true
# One proxy (Caddy) in front: the client is the LAST X-Forwarded-For entry. Do not raise unless a second proxy is added.
TRUST_PROXY_HOPS=1
# Leave UNSET. (Only for a header that the proxy overwrites on every request, e.g. cf-connecting-ip behind Cloudflare.)
# CLIENT_IP_HEADER=

# --- Behaviour ----------------------------------------------------------------------------------------------------------
SCHEDULER_ENABLED=true
# Optional: SCHEDULER_INTERVAL_SECONDS=60
# Must stay false: schema changes come from migrations only.
PAYLOAD_DB_PUSH=false

# --- Optional limits (defaults shown; uncomment to change) --------------------------------------------------------------
# SUBMISSION_RATE_LIMIT=5
# SUBMISSION_RATE_WINDOW_SECONDS=900
# SUBMISSION_EMAIL_RATE_LIMIT=3
# SUBMISSION_EMAIL_RATE_WINDOW_SECONDS=3600
# SUBMISSION_DUPLICATE_WINDOW_HOURS=72
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_FORGOT_RATE_LIMIT=5
# AUTH_RESET_RATE_LIMIT=10
# AUTH_RATE_WINDOW_SECONDS=900

# --- E-mail (out of scope for this staging: password-reset mail is NOT configured) ---------------------------------------
# Without SMTP_HOST the CMS cannot send reset e-mails. Use the synthetic logins from the credentials file instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM_ADDRESS=        (required when SMTP_HOST is set)
# EMAIL_FROM_NAME=Church Times CMS

# --- Deliberately NOT set --------------------------------------------------------------------------------------------------
# CMS_ALLOW_INSECURE_LOCAL_STAGING  loopback/test-secret escape hatch. Never in .env.cms; with real https origins the CMS
#                                   would refuse to start. (Only the one-shot `seed` service sets it, for itself.)
# NODE_ENV, PORT, HOSTNAME          set by the image (production, 3000, 0.0.0.0).
# SEED_DEMO_USERS / SEED_DEMO_PASSWORD  local development only.
