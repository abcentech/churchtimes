# Build-time settings for the staff newsroom SPA (copy to .env.local for local builds; never commit secrets).
# CMS base URL, no trailing slash. Must share a registrable domain with the newsroom host
# (e.g. newsroom.example.org + cms.example.org) because the staff cookie is SameSite=Lax.
# Leave empty only if the CMS is reverse-proxied under /api on the newsroom's own origin.
VITE_CMS_URL=http://cms.churchtimes.localhost:3000
# Optional: public website origin, used only to link to its tip form (the form is not part of this app).
VITE_PUBLIC_SITE_URL=
# Optional: comma-separated hosts the archive review treats as known outbound-link hosts (subdomains included). The public site host is
# always known. Links to any other host are flagged for the reviewer.
VITE_KNOWN_LINK_HOSTS=
