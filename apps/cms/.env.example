# Copy to .env and fill in. NEVER commit .env. Server-side only: none of these values may ever be
# put in frontend code (the only value a frontend needs is the PUBLIC Turnstile site key, see below).

# PostgreSQL connection string. For local dev run `npm run db:local` (prints this URL).
# Local-only embedded DB credentials are NOT secrets: churchtimes / churchtimes-local
DATABASE_URL=postgres://churchtimes:churchtimes-local@127.0.0.1:54329/churchtimes

# Payload secret, >= 32 random chars (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# Signs login tokens. Changing it signs every user out.
PAYLOAD_SECRET=replace-with-64-hex-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of this CMS: a bare origin, no trailing slash, no path.
# REQUIRED in production and must be https (the app refuses to start otherwise). It is also added to the
# CSRF allowlist automatically and used for password-reset links and media URLs.
CMS_PUBLIC_URL=http://localhost:3000
# Largest audio/video upload (MB, default 100, maximum 500) for the article audio/video block. Setting it EXPLICITLY also raises the
# /api/media request limit for signed-in staff with a verified session (max(10, this) + 1 MB); anonymous requests stay at 11 MB, and
# unset keeps 11 MB for everyone. Raise only the /api/media location of the reverse proxy to match (docs/operations.md 4.4).
# MEDIA_UPLOAD_MAX_MB (11 to 500) is an optional explicit override of that limit.
# MEDIA_AV_MAX_MB=100

# In production CMS_CORS_ORIGINS, CMS_CSRF_ORIGINS and PUBLIC_SUBMISSION_ORIGINS must each be non-empty (startup fails otherwise).
# Comma-separated origins allowed for CORS (browser frontends calling the API). Explicit origins only:
# no "*", no paths, https only in production (http://localhost is accepted in development).
# 5173 = public site dev server, 5174 = newsroom UI dev server, 8080 = static preview.
CMS_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
# Comma-separated origins allowed to make cookie-authenticated requests (Payload csrf). CMS_PUBLIC_URL is
# always included. Add the newsroom UI origin if it calls the API with credentials:'include'.
CMS_CSRF_ORIGINS=http://localhost:3000,http://localhost:5174

# Origins allowed to POST /api/public/submissions. REQUIRED (non-empty) in production.
PUBLIC_SUBMISSION_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
# If unset in production, cross-origin browser submissions are rejected (requests without Origin pass).

# --- Client IP for rate limits (reverse proxy) -----------------------------------------------------
# REQUIRED to be true in production (the app refuses to start otherwise): the CMS always runs behind a
# reverse proxy (Caddy/nginx, see docs/operations.md section 4.4) that OVERWRITES X-Forwarded-For / X-Real-IP.
# Leave false in local development: all clients then share one rate-limit bucket (fails closed for
# submissions; login uses a larger bucket).
TRUST_PROXY=false
# Number of trusted proxies in front of the app (1..10, default 1). The client is the X-Forwarded-For
# entry this many places from the RIGHT (the address your own proxy appended), not the spoofable leftmost.
# TRUST_PROXY_HOPS=1
# Optional: a single header that carries the client address and takes precedence over X-Forwarded-For.
# Use cf-connecting-ip behind Cloudflare (firewall the origin to Cloudflare's ranges), or x-real-ip when
# nginx sets it with `proxy_set_header X-Real-IP $remote_addr`. Only when TRUST_PROXY=true.
# CLIENT_IP_HEADER=x-real-ip

# --- Cloudflare Turnstile (public submissions) -------------------------------------------------------
# SECRET key from the Cloudflare dashboard (Turnstile > your widget). REQUIRED in production; the app
# refuses to start without it, and rejects Cloudflare's dummy test secrets there.
# In development, if unset, Cloudflare's always-pass TEST secret is used (with a loud warning).
# Never commit the real value. Rotate it in the Cloudflare dashboard if it leaks.
# TURNSTILE_SECRET_KEY=
# The SITE key is public and belongs in the FRONTEND build (not read by this backend):
# TURNSTILE_SITE_KEY=
# REQUIRED in production (startup fails while unset): only accept tokens issued on these hostnames (comma list).
# TURNSTILE_ALLOWED_HOSTNAMES=www.churchtimesnigeria.net
# REQUIRED in production (startup fails while unset): comma-separated widget actions to accept. Must include the
# value the public site sends as VITE_TURNSTILE_ACTION (root .env.example; both forms send it when set; if unset they fall back to
# submit-story and submit-contact, and contact has no CMS endpoint yet). Without a list entry for the action the widget sends, every tip is rejected.
# TURNSTILE_EXPECTED_ACTION=submit-story,contact-message,newsletter-subscribe
# Every public form has its OWN widget action, and the CMS also pins each endpoint to its action (a token minted for one
# form is refused by another). When you set the list, include every action the public site sends:
#   submit-story (stories), contact-message (POST /api/public/contact), newsletter-subscribe (POST /api/public/newsletter/subscribe)
# e.g. TURNSTILE_EXPECTED_ACTION=submit-story,contact-message,newsletter-subscribe

# --- Public submission limits ----------------------------------------------------------------------
# Max submissions per IP per window, and window length in seconds
SUBMISSION_RATE_LIMIT=5
SUBMISSION_RATE_WINDOW_SECONDS=900
# Max submissions per email address per window (counted after Turnstile passes), window in seconds
SUBMISSION_EMAIL_RATE_LIMIT=3
SUBMISSION_EMAIL_RATE_WINDOW_SECONDS=3600
# Identical email+title+body within this many hours is rejected with 409
SUBMISSION_DUPLICATE_WINDOW_HOURS=72
# ADMIN-configurable: true makes consent: true mandatory on POST /api/public/submissions (400 field consent).
# Default false until the public form sends it.
SUBMISSIONS_REQUIRE_CONSENT=false

# --- Contact form (POST /api/public/contact, go-live contract C5) -----------------------------------
# Origins are PUBLIC_SUBMISSION_ORIGINS (above). Turnstile action: contact-message (see TURNSTILE_EXPECTED_ACTION).
# Max contact messages per IP per window (seconds). Per e-mail address the limit is fixed at 3 per hour.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=900
# Who is e-mailed when a message arrives: comma list (max 10), SERVER-SIDE ONLY, never returned to a browser. Invalid entries
# stop the app starting in production. Needs SMTP below. If unset or SMTP is missing the message is still stored and shows
# in CMS > Contact messages with notifyStatus "not-configured" (a send failure shows "failed"); the sender still gets a normal 201.
# CONTACT_NOTIFY_TO=desk@example.org,editor@example.org

# --- Newsletter (go-live contract C4) ------------------------------------------------------------------
# Public sign-up (POST /api/public/newsletter/subscribe) is double opt-in and needs SMTP below. In production, with SMTP or
# PUBLIC_SITE_URL missing, it answers 503 "Sign-up is unavailable." and stores nothing. Turnstile action: newsletter-subscribe.
# Public SITE origin used for the link in the confirmation e-mail (<PUBLIC_SITE_URL>/newsletter/confirm?token=...). A bare origin,
# https only in production (http://localhost is accepted in development). The link never points at this API.
# PUBLIC_SITE_URL=https://www.example.org
# HMAC key that signs unsubscribe links (>= 32 random chars, different from PAYLOAD_SECRET and PREVIEW_SECRET).
# REQUIRED in production (the app refuses to start without it). Changing it invalidates every unsubscribe link already e-mailed.
# NEWSLETTER_TOKEN_SECRET=replace-with-another-random-secret-xxxxxxxxxxxxxxxx
# Sign-ups per IP per window (seconds). Per e-mail address the limit is fixed at 3 per hour.
NEWSLETTER_RATE_LIMIT=5
NEWSLETTER_RATE_WINDOW_SECONDS=900

# Public search GET /api/public/search: requests per client IP per window (defaults 60 per 60 s).
SEARCH_RATE_LIMIT=60
# Largest page size (1 to 100, default 20) and number of matches counted for totalDocs (1 to 10000, default 1000).
# SEARCH_MAX_LIMIT=20
# SEARCH_COUNT_CAP=1000
SEARCH_RATE_WINDOW_SECONDS=60
# Staff related-articles (POST /api/staff/related-articles): per-user limit per window.
STAFF_RELATED_RATE_LIMIT=30
STAFF_RELATED_RATE_WINDOW_SECONDS=60
# Per-IP limit for the confirm and unsubscribe links (same window as above).
# NEWSLETTER_TOKEN_RATE_LIMIT=20
# Mail-bombing guards for confirmation e-mails (besides the 3 per hour per address). If a confirmation was already sent to an
# address within the cooldown, the sign-up still answers the same neutral 202 but sends nothing (0 turns the cooldown off).
# NEWSLETTER_RESEND_COOLDOWN_SECONDS=600
# Most confirmation e-mails one address can be sent in a rolling 24 hours; beyond that, same neutral 202, nothing sent.
# NEWSLETTER_MAX_CONFIRM_MAILS_PER_DAY=5
# Addresses with status "bounced" are never mailed automatically (staff can reset the status).

# --- Staff authentication limits -------------------------------------------------------------------
# Per-IP limits for POST /api/users/login | forgot-password | reset-password, per window (seconds).
# (Per-account lockout is separate: 5 failed logins lock the account for 10 minutes.)
AUTH_LOGIN_RATE_LIMIT=10
AUTH_FORGOT_RATE_LIMIT=5
AUTH_RESET_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900

# --- E-mail (password reset) -----------------------------------------------------------------------
# Leave SMTP_HOST unset in development: Payload prints e-mails (including reset links) to the console.
# In production SMTP_HOST is REQUIRED (startup fails without it): configure any SMTP server (your existing mailbox, a
# free-tier relay, ...) together with EMAIL_FROM_ADDRESS. Explicit opt-out for a deployment without mail:
# CMS_ALLOW_NO_SMTP=true (startup then only warns; password resets cannot be delivered, see docs/operations.md break-glass).
# CMS_ALLOW_NO_SMTP=false
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=cms@example.org
# SMTP_PASS=
# true = implicit TLS (port 465); false = STARTTLS (port 587, required in production)
# SMTP_SECURE=false
# EMAIL_FROM_ADDRESS=cms@example.org
# EMAIL_FROM_NAME=Church Times CMS

# HMAC secret for article preview tokens (>= 32 random chars, different from PAYLOAD_SECRET)
PREVIEW_SECRET=replace-with-another-random-secret-xxxxxxxxxxxxxxxxxxxxxxxx
# Salt for hashing client IPs on submissions (>= 16 random chars)
IP_HASH_SALT=replace-with-random-salt-xxxxxxxxxxxxxxxx

# Scheduled-publishing loop (in-process). true/false and interval in seconds
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Production only: POST /api/users/first-register on an EMPTY database is refused (403) unless this is exactly "true". Leave it unset
# and create the first admin on the server with `npm run admin:create` before the proxy exposes the site (docs/operations.md).
# ALLOW_FIRST_REGISTER=false

# Schema push (dev only). Default false: use migrations (`npm run migrate`).
PAYLOAD_DB_PUSH=false

# Seed script: create one demo user per role (LOCAL DEVELOPMENT ONLY).
# Passwords are read from SEED_DEMO_PASSWORD (>= 12 chars, must satisfy the password policy); never reuse it anywhere.
SEED_DEMO_USERS=false
# SEED_DEMO_PASSWORD=

# Optional: local embedded postgres port (scripts/local-db.mjs)
# LOCAL_PG_PORT=54329

# --- Redirects (go-live C7) -------------------------------------------------------------------------
# Where an article lives on the public site: exactly "/{slug}/" (default, owner decision D1: the same address as on WordPress) or
# "/reports/{slug}/" (alternative). Must equal the value the public host reads: the exporter and the host must never disagree. Any other
# value stops the CMS at startup.
# PUBLIC_ARTICLE_PATH_TEMPLATE=/{slug}/
# Comma list of bare host names a redirect `to` may point at as an absolute https URL (no scheme, port or path).
# Unset = only internal paths are accepted.
# REDIRECT_ALLOWED_HOSTS=www.example.org
# MUST equal the public host's PUBLIC_REDIRECT_ALLOWED_HOSTS (the host also needs PUBLIC_SITE_URL): one disagreement makes
# the host reject the WHOLE list.
# Host names the old WordPress addresses (`legacyUrl`) may carry; others derive no rule. Default:
# churchtimesnigeria.net,www.churchtimesnigeria.net
# LEGACY_SITE_HOSTS=old.example.org

# --- Advertising (go-live C3) -----------------------------------------------------------------------
# While true (default), a campaign can only be approved, and is only delivered, when its paymentStatus is paid or waived.
# Only the literal value "false" turns the gate off (owner decision D4).
# ADS_REQUIRE_PAYMENT=true
# Flags reported by GET /api/public/advertising. The CMS never delivers an AdSense publisher id or script.
# PUBLIC_ADSENSE_ENABLED=false
# PUBLIC_ADSENSE_REVIEWED=false
