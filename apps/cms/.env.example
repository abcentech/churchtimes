# Copy to .env and fill in. NEVER commit .env.

# PostgreSQL connection string. For local dev run `npm run db:local` (prints this URL).
# Local-only embedded DB credentials are NOT secrets: churchtimes / churchtimes-local
DATABASE_URL=postgres://churchtimes:churchtimes-local@127.0.0.1:54329/churchtimes

# Payload secret, >= 32 random chars (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
PAYLOAD_SECRET=replace-with-64-hex-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of this CMS (no trailing slash)
CMS_PUBLIC_URL=http://localhost:3000

# Comma-separated origins allowed for CORS (browser frontends calling the API)
CMS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Comma-separated origins allowed to make cookie-authenticated mutations (Payload csrf)
CMS_CSRF_ORIGINS=http://localhost:3000

# Origins allowed to POST /api/public/submissions
PUBLIC_SUBMISSION_ORIGINS=http://localhost:5173,http://localhost:8080
# If unset in production, cross-origin browser submissions are rejected (requests without Origin pass).
# Set true ONLY behind your own reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
# When false, all clients share one rate-limit bucket (fails closed).
TRUST_PROXY=false
# Max submissions per IP per window, and window length in seconds
SUBMISSION_RATE_LIMIT=5
SUBMISSION_RATE_WINDOW_SECONDS=900

# HMAC secret for article preview tokens (>= 32 random chars)
PREVIEW_SECRET=replace-with-another-random-secret-xxxxxxxxxxxxxxxxxxxxxxxx
# Salt for hashing client IPs on submissions (>= 16 random chars)
IP_HASH_SALT=replace-with-random-salt-xxxxxxxxxxxxxxxx

# Scheduled-publishing loop (in-process). true/false and interval in seconds
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Schema push (dev only). Default false: use migrations (`npm run migrate`).
PAYLOAD_DB_PUSH=false

# Seed script: create one demo user per role (LOCAL DEVELOPMENT ONLY).
# Passwords are read from SEED_DEMO_PASSWORD (>= 12 chars); never reuse it anywhere.
SEED_DEMO_USERS=false
# SEED_DEMO_PASSWORD=

# Optional: local embedded postgres port (scripts/local-db.mjs)
# LOCAL_PG_PORT=54329
