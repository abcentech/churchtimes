{
  "name": "churchtimes-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Church Times Nigeria newsroom CMS (Payload 3 + PostgreSQL)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed": "payload run src/seed/index.ts",
    "admin:set-password": "payload run src/seed/setPassword.ts --",
    "admin:create": "payload run src/seed/createAdmin.ts --",
    "import:subscribers": "payload run src/seed/importSubscribers.ts --",
    "newsletter:reconfirm": "payload run src/seed/reconfirmSubscribers.ts --",
    "newsletter:purge-unconfirmed": "payload run src/seed/purgeUnconfirmedSubscribers.ts --",
    "export:redirects": "payload run src/scripts/exportRedirects.ts --",
    "export:media-map": "payload run src/scripts/exportMediaMap.ts --",
    "check:redirects": "payload run src/scripts/checkRedirects.ts --",
    "import:wxr-report": "tsx src/seed/importWxrReport.ts",
    "import:inspect": "tsx src/seed/importInspect.ts",
    "import:wxr": "payload run src/seed/importWxr.ts --",
    "import:rollback": "payload run src/seed/importRollback.ts --",
    "import:uploads-check": "tsx scripts/import-uploads-check.ts",
    "import:rehearse": "tsx scripts/import-rehearse.ts",
    "import:convert-wxr": "tsx scripts/import-convert-stats.ts",
    "import:categorise-eval": "tsx scripts/import-categorise-eval.ts",
    "perf:read": "tsx scripts/perf-read-paths.ts",
    "import:redirects": "payload run src/scripts/importRedirects.ts --",
    "import:convert": "tsx src/scripts/convertHtmlReport.ts",
    "db:local": "node scripts/local-db.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "staging:up": "node scripts/staging-up.mjs",
    "staging:down": "node scripts/staging-down.mjs",
    "test:e2e:api": "vitest run -c vitest.e2e.config.ts",
    "test:e2e:browser": "playwright test -c playwright.config.ts",
    "test:e2e:browser:install": "playwright install chromium",
    "test:e2e:cross-app": "playwright test -c playwright.cross-app.config.ts",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:browser"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "10.1.0",
    "graphql": "16.14.2",
    "next": "16.3.8",
    "parse5": "7.3.0",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sax": "1.6.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "sass": "1.105.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
