{
  "description": "Test vectors for the single redirect path normalisation contract (apps/cms/src/lib/redirectPaths.ts, normalizePath and normalizeRequestPath). The CMS tests run them; the public host should run the same vectors against its copy of the function. Synthetic data only.",
  "normalize": [
    { "input": "/old-slug", "path": "/old-slug/", "note": "trailing slash added to a directory-style path" },
    { "input": "/old-slug/", "path": "/old-slug/" },
    { "input": "/2019/05/some-story", "path": "/2019/05/some-story/" },
    { "input": "/feed.xml", "path": "/feed.xml", "note": "file extension: no slash added" },
    { "input": "/wp-content/uploads/a.jpg", "path": "/wp-content/uploads/a.jpg" },
    { "input": "/", "path": "/" },
    { "input": "  /padded  ", "path": "/padded/", "note": "surrounding whitespace is trimmed" },
    { "input": "/Old-Slug/", "path": "/Old-Slug/", "note": "case is preserved" },
    { "input": "/caf%c3%a9/", "path": "/caf%C3%A9/", "note": "upper-case hex" },
    { "input": "/caf%C3%A9", "path": "/caf%C3%A9/" },
    { "input": "/café/", "path": "/caf%C3%A9/", "note": "raw Unicode is encoded as UTF-8" },
    { "input": "/cafe%CC%81/", "path": "/caf%C3%A9/", "note": "NFD (e + combining acute) is NFC-normalised first" },
    { "input": "/%41bc/", "path": "/Abc/", "note": "unreserved characters are decoded" },
    { "input": "/a%20b/", "path": "/a%20b/" },
    { "input": "/it's/", "path": "/it%27s/", "note": "apostrophe is encoded" },
    { "input": "/it%27s/", "path": "/it%27s/" },
    { "input": "/a+b(c)/", "path": "/a%2Bb%28c%29/" },
    { "input": "/a%2db/", "path": "/a-b/", "note": "%2D is a hyphen, which is unreserved" },
    { "input": "/ünï/cödé", "path": "/%C3%BCn%C3%AF/c%C3%B6d%C3%A9/" }
  ],
  "reject": [
    { "input": "", "why": "empty" },
    { "input": "no-slash", "why": "must start with a slash" },
    { "input": "https://example.test/a/", "why": "scheme and host" },
    { "input": "//example.test/a/", "why": "protocol-relative" },
    { "input": "javascript:alert(1)", "why": "scheme" },
    { "input": "/a\\b/", "why": "backslash" },
    { "input": "/a%5Cb/", "why": "encoded backslash" },
    { "input": "/a%5cb/", "why": "encoded backslash, lower case" },
    { "input": "/a%2Fb/", "why": "encoded slash" },
    { "input": "/a%2fb/", "why": "encoded slash, lower case" },
    { "input": "/a%25b/", "why": "encoded percent" },
    { "input": "/a%23b/", "why": "encoded hash" },
    { "input": "/a%0D%0Ab/", "why": "encoded CRLF" },
    { "input": "/a%00b/", "why": "encoded NUL" },
    { "input": "/a%7Fb/", "why": "encoded DEL" },
    { "input": "/a%C2%85b/", "why": "encoded C1 control (NEL)" },
    { "input": "/a%C2%9Fb/", "why": "encoded C1 control" },
    { "input": "/a%E2%80%A8b/", "why": "encoded U+2028 line separator" },
    { "input": "/a%E2%80%A9b/", "why": "encoded U+2029 paragraph separator" },
    { "input": "/%C3/", "why": "truncated UTF-8 sequence" },
    { "input": "/%FF/", "why": "invalid UTF-8 byte" },
    { "input": "/%C0%AF/", "why": "overlong UTF-8" },
    { "input": "/%ED%A0%80/", "why": "UTF-16 surrogate encoded as UTF-8" },
    { "input": "/a%zz/", "why": "bad percent escape" },
    { "input": "/a%4/", "why": "truncated percent escape" },
    { "input": "/a/../b/", "why": "dot segment" },
    { "input": "/a/./b/", "why": "dot segment" },
    { "input": "/a/%2e%2e/b/", "why": "encoded dot segment" },
    { "input": "/a//b/", "why": "empty segment" },
    { "input": "/a b/", "why": "raw space" },
    { "input": "/a\tb/", "why": "raw tab" },
    { "input": "/a/?p=1", "why": "query string" },
    { "input": "/a/#top", "why": "fragment" },
    { "input": "/category/*", "why": "wildcard" },
    { "input": "/data:x/", "why": "scheme-like first segment" },
    { "input": "/tel:2019/", "why": "scheme-like first segment" },
    { "input": "/mailto:a@example.test/", "why": "scheme-like first segment" },
    { "input": "/javascript:alert(1)/", "why": "scheme-like first segment" },
    { "input": "/https:/example.test/", "why": "scheme-like first segment" },
    { "input": "/TEL:2019/", "why": "scheme-like first segment, upper case" },
    { "input": "/tel%3A2019/", "why": "encoded colon makes a scheme-like segment" },
    { "input": "/news/tel:2019/", "why": "scheme-like later segment" },
    { "input": "/news/data:x/", "why": "scheme-like later segment" },
    { "input": "/x:y/", "why": "any name: first segment" }
  ],
  "request": [
    { "input": "/old-slug?utm_source=x#top", "path": "/old-slug/", "note": "query and fragment removed first" },
    { "input": "/Old-Slug", "path": "/Old-Slug/" },
    { "input": "/caf%c3%a9?x=%", "path": "/caf%C3%A9/", "note": "a stray % in the query is not a reason to 404" },
    { "input": "/it's", "path": "/it%27s/" },
    { "input": "/a/../b", "path": null },
    { "input": "//example.test/", "path": null },
    { "input": "/a%2Fb", "path": null },
    { "input": "/%C3", "path": null },
    { "input": "/", "path": "/" },
    { "input": "/?p=77", "path": "/" }
  ],
  "rootArticlePath": {
    "description": "Article paths under the default template /{slug}/ (owner decision D1). `request` is what a visitor or the WordPress export may send; `path` is the one canonical key. A request equal to the article path needs NO redirect rule.",
    "vectors": [
      { "request": "/my-story/", "path": "/my-story/", "slug": "my-story", "note": "canonical" },
      { "request": "/my-story", "path": "/my-story/", "slug": "my-story", "note": "missing trailing slash" },
      { "request": "/My-Story/", "path": "/My-Story/", "slug": null, "note": "case is preserved, so this is not the lower-case slug" },
      { "request": "/caf%c3%a9/", "path": "/caf%C3%A9/", "slug": null, "note": "percent-encoded: not a valid ASCII slug, never an article path" },
      { "request": "/my-story/?utm_source=x", "path": "/my-story/", "slug": "my-story", "note": "query removed" },
      { "request": "/a/b/", "path": "/a/b/", "slug": null, "note": "two segments is not a root article" }
    ]
  }
}
