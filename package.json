{
  "name": "churchtimes-nigeria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:newsroom": "vite apps/newsroom --port 5174 --host 0.0.0.0",
    "dev:newsroom:mock": "vite apps/newsroom --mode mock --port 5174 --host 0.0.0.0",
    "build": "vite build && node tools/prepare-pages.mjs",
    "build:newsroom": "vite build apps/newsroom",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:unit": "node --test unit-tests/*.test.js",
    "test:newsroom": "playwright test --config playwright.newsroom.config.js",
    "test:newsroom-app": "playwright test --config playwright.newsroom-app.config.js",
    "export:pages": "npm run build && node tools/export-pages.mjs",
    "check:pages": "node tools/check-pages-export.mjs",
    "test:forms": "playwright test --config playwright.forms.config.js",
    "test:advertising": "playwright test --config playwright.advertising.config.js",
    "test:cms": "node tools/run-public-cms-tests.mjs",
    "test:newsroom-unit": "node --test apps/newsroom/test/*.test.js",
    "serve:public": "node tools/serve-public.mjs",
    "test:quality": "node tools/run-public-quality.mjs",
    "check:redirects": "node tools/check-redirects.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "lighthouse": "12.8.2",
    "vite": "7.3.1"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0"
  }
}
