# Public Vite configuration only. Never add secrets to VITE_ variables.
# Empty values keep online form sending disabled.
VITE_PUBLIC_CMS_URL=
VITE_PUBLIC_SUBMISSIONS_URL=
VITE_PUBLIC_CONTACT_URL=
VITE_TURNSTILE_SITE_KEY=

# Must match TURNSTILE_EXPECTED_ACTION on the CMS (public metadata, not a secret).
VITE_TURNSTILE_ACTION=submit-story

# Public canonical origin/path for the staging public frontend (never a CMS secret).
# Required for subpath hosting; staging hosting must rewrite /reports/*, /sections/*
# and /search/ to the public HTML entry. Hash routes alone are not an SEO solution.
VITE_PUBLIC_SITE_URL=
