# Public Vite configuration only. Never add secrets to VITE_ variables.
# Empty values keep online form sending disabled.
VITE_PUBLIC_CMS_URL=
VITE_PUBLIC_SUBMISSIONS_URL=
VITE_PUBLIC_CONTACT_URL=
VITE_TURNSTILE_SITE_KEY=

# Must match TURNSTILE_EXPECTED_ACTION on the CMS (public metadata, not a secret).
VITE_TURNSTILE_ACTION=submit-story

# Canonical publication HTTPS origin (never the CMS origin); staging may leave blank.
VITE_PUBLIC_SITE_URL=

# Giving (docs/w12/giving.md): the CMS giving API base, e.g. https://cms.example.org/api/public/giving.
# Empty = no Give page and no "Support our journalism" ask in the build. Needs VITE_TURNSTILE_SITE_KEY too.
VITE_PUBLIC_GIVING_URL=
